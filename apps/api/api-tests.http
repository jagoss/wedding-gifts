  "action": "payment.created",
  "data":


###############################################################################
# END OF TEST SUITE
###############################################################################
# 
# Summary of HTTP Status Codes Used:
# - 200 OK: Successful GET/PATCH/POST operations
# - 201 Created: Successful resource creation
# - 204 No Content: Successful deletion
# - 400 Bad Request: Validation errors, malformed requests
# - 401 Unauthorized: Missing or invalid authentication
# - 403 Forbidden: Insufficient permissions
# - 404 Not Found: Resource doesn't exist
# - 409 Conflict: Duplicate resource (e.g., slug, email)
# - 500 Internal Server Error: Unexpected server errors
#
# Notes:
# - Delete operations are commented out to prevent accidental data loss
# - Update @accessToken, @weddingId, @giftId, etc. after creating resources
# - Webhook endpoints typically don't require authentication
# - All error responses follow the format: {"error": {"message": "..."}}
###############################################################################

